[node name="Desc1" type="RichTextLabel" parent="Panel/VBox/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "[color=#2e7d32]♣ クラブ[/color]: 与ダメージ2倍
[color=#2196f3]♠ スペード[/color]: 敵の攻撃力を数値分永続軽減(シールド)
[color=#e53935]♦ ダイヤ[/color]: 山札から数値分ドロー(上限8枚)
[color=#ff5252]♥ ハート[/color]: 捨て札をシャッフルし山札の底へ戻す"
fit_content = true

[node name="Section2" type="Label" parent="Panel/VBox/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.8, 1, 1)
theme_override_font_sizes/font_size = 15
text = "【特殊ルール】"

[node name="Desc2" type="RichTextLabel" parent="Panel/VBox/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "・[b]スート耐性[/b]: 敵と同じスートのカードは能力無効(ダメージのみ)
・[b]相棒(A)[/b]: パワー1。単体または他の任意のカード1枚とペア出撃可能
・[b]セット出し[/b]: 同じ数字のカードは合計<=10まで同時プレイ可能
・[b]ぴったり撃破(Exact Kill)[/b]: 敵HPちょうど0で倒すと山札トップに仲間入り！
・[b]反撃[/b]: 敵が生きていればATK分のカードを捨てて防御。足りないとGAME OVER"
fit_content = true

[node name="Section3" type="Label" parent="Panel/VBox/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.8, 1, 1)
theme_override_font_sizes/font_size = 15
text = "【🃏 道化師 (Joker)】"

[node name="Desc3" type="RichTextLabel" parent="Panel/VBox/ScrollContainer/ContentVBox"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "・攻撃時: 敵のスート耐性を完全解除 ＆ 手札を8枚までリフレッシュドロー(反撃なし)
・反撃時: 1枚捨てるだけで敵のいかなる攻撃も完全防御"
fit_content = true

